BT 1 0 0 1 0 37.4 Tm 11.5 TL /F1 8.6 Tf .156863 .192157 .239216 rg (function onCellEdit\(sysIDs, table, oldValues, newValue, callback\) {) Tj  T* (alert\('State cannot be updated using list editing. Please open the Incident.'\);) Tj  T* (callback\(false\);) Tj  T* (}) Tj T* ET
